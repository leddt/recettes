    "@fontsource/caveat": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "^7.1.0",
    "openai": "^4.104.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.15.1",
    "remark-gfm": "^4.0.1",
